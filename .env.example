# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/mktgogo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mktgogo
DB_USER=user
DB_PASSWORD=password
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=30m
JWT_ALGORITHM=HS256

# Refresh Token Configuration
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Email Verification Token Configuration
EMAIL_VERIFICATION_TOKEN_EXPIRATION_HOURS=24

# Password Reset Token Configuration
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Email Service Configuration (SMTP)
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@mktgogo.com

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_EMAIL_VERIFICATION_MAX=3
RATE_LIMIT_EMAIL_VERIFICATION_WINDOW_MS=3600000
RATE_LIMIT_REGISTRATION_MAX=3
RATE_LIMIT_REGISTRATION_WINDOW_MS=3600000

# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
HTTPS_ONLY=true
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict

# Logging Configuration
LOG_LEVEL=info

# Payment Gateway Configuration
STRIPE_API_KEY=sk_test_your_stripe_api_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
PAYSTACK_API_KEY=sk_test_your_paystack_api_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Encryption Configuration
ENCRYPTION_MASTER_KEY=your-encryption-master-key-change-this-in-production

# Payment Rate Limiting Configuration
RATE_LIMIT_PAYMENT_INITIATION_MAX=10
RATE_LIMIT_PAYMENT_INITIATION_WINDOW_MS=900000
RATE_LIMIT_PAYOUT_REQUEST_MAX=5
RATE_LIMIT_PAYOUT_REQUEST_WINDOW_MS=3600000
RATE_LIMIT_REFUND_PROCESSING_MAX=10
RATE_LIMIT_REFUND_PROCESSING_WINDOW_MS=3600000
RATE_LIMIT_WALLET_QUERY_MAX=30
RATE_LIMIT_WALLET_QUERY_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=100
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
